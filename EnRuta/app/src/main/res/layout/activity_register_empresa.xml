<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5E7EB">

    <include
        layout="@layout/company_background_login" />

    <!-- Card de login superpuesto parcialmente sobre la imagen -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="100dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registro de Empresa"
                android:textColor="@color/blue_logo"
                android:textSize="24sp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:textStyle="bold"/>
            <!-- Botones de pestaña -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnIniciarSesionSwift"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Iniciar sesión"
                        android:backgroundTint="@null"
                        android:textColor="@color/white"
                        app:backgroundTint="@null"
                        android:translationZ="8dp"
                        android:elevation="8dp"/>

                    <Button
                        android:id="@+id/btnRegistrarseSwift"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@null"
                        android:text="Registrarse"
                        android:textColor="@color/white"
                        app:backgroundTint="@null" />


                </LinearLayout>
            </FrameLayout>

            <!-- Input contacto -->
            <EditText
                android:id="@+id/etNombreEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Nombre de empresa"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:textColor="@color/white_hueso"
                android:paddingBottom="8dp"
                android:layout_marginBottom="0dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <!-- Línea separadora -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_below="@id/etNombreEmpresa"
                android:layout_marginTop="0dp"/>

            <!-- Input contraseña -->
            <EditText
                android:id="@+id/etNit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="NIT"
                android:background="@android:color/transparent"
                android:inputType="phone"
                android:textColor="@color/white_hueso"
                android:paddingBottom="8dp"
                android:layout_marginBottom="0dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Correo"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:textColor="@color/white_hueso"
                android:paddingBottom="8dp"
                android:layout_marginBottom="0dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <EditText
                android:id="@+id/etRepresentanteLlegal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Representante legal"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:textColor="@color/white_hueso"
                android:paddingBottom="0dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <EditText
                android:id="@+id/etTipoEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Tipo de empresa"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:textColor="@color/white_hueso"
                android:paddingBottom="0dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <EditText
                android:id="@+id/etDirrecion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Dirección"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:textColor="@color/white_hueso"
                android:paddingBottom="0dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <EditText
                android:id="@+id/etContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Contacto"
                android:background="@android:color/transparent"
                android:inputType="phone"
                android:textColor="@color/white_hueso"
                android:paddingBottom="0dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />
            <!-- Botón iniciar sesión -->

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Contraseña"
                android:background="@android:color/transparent"
                android:inputType="textPassword"
                android:textColor="@color/white_hueso"
                android:paddingBottom="0dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:textSize="15sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnRegistrarseEmpresa"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_azul"
                    android:text="Registrarse"
                    android:textColor="@color/white"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"/>

            </LinearLayout>

            <!-- Texto olvidaste contraseña -->
            <TextView
                android:id="@+id/tvTienesCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="¿Ya tienes cuenta?"
                android:textColor="@color/blue_logo"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tvRecuperar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/iniciaSeccion"
                android:textColor="@color/blue_logo"
                android:textSize="15sp"
                android:layout_below="@id/tvTienesCuenta" />
        </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</merge>
