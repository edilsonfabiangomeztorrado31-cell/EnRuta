<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.company.GestionFletesActivity">

  <androidx.cardview.widget.CardView
      android:id="@+id/cardLogin"
      android:layout_width="match_parent"
      android:layout_height="600dp"
      android:layout_marginStart="24dp"
      android:layout_marginEnd="24dp"
      app:cardCornerRadius="24dp"
      app:cardElevation="6dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:background="#FFFFFF">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="24dp"
          android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/layoutLugarOrigenUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            android:background="@android:color/white">
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutLugarDestinoUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            android:background="@android:color/white">
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBuscarCiudad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            android:background="@android:color/white">
        </LinearLayout>


        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Flete"
            android:textColor="@color/blue_logo"
            android:textSize="24sp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textStyle="bold"/>

        <!-- Ubicación Origen -->
        <EditText
            android:id="@+id/etUbicacionOrigen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ubicación origen"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="8dp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"/>

<!--        <com.google.android.gms.maps.MapView-->
<!--            android:id="@+id/mapOrigen"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="200dp"-->
<!--            android:clickable="true" />-->

        <!-- Ubicación Destino -->
        <EditText
            android:id="@+id/etUbicacionDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ubicación destino"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="8dp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"/>


        <!--        <com.google.android.gms.maps.MapView-->
<!--            android:id="@+id/mapDestino"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="200dp"-->
<!--            android:clickable="true" />-->

        <!-- Tipo de carga -->
        <EditText
            android:id="@+id/etTipoCarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo de carga"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="16dp"/>

        <!-- Precio -->
        <EditText
            android:id="@+id/etPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp"/>

        <!-- Peso -->
        <EditText
            android:id="@+id/etPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Peso en toneladas"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp"/>

        <!-- Fecha de registro -->
        <EditText
            android:id="@+id/etFechaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha de registro"
            android:focusable="false"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="10dp">

          <Button
              android:id="@+id/btnRegistrarFlete"
              android:layout_width="180dp"
              android:layout_height="wrap_content"
              android:background="@drawable/bg_button_azul"
              android:text="Registrarse"
              android:textColor="@color/white"
              android:backgroundTint="@null"
              app:backgroundTint="@null"/>


        </LinearLayout>
      </LinearLayout>
    </ScrollView>
  </androidx.cardview.widget.CardView>

  </androidx.constraintlayout.widget.ConstraintLayout>