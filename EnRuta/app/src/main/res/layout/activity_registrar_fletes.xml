<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

    <!-- TITULO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar Nuevo Flete"
        android:textColor="#002046"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- ORIGEN -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UBICACIÓN ORIGEN"
        android:textStyle="bold"
        android:textColor="#44474E"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:startIconDrawable="@drawable/ic_location">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etUbicacionOrigen"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="Ej: Buenos Aires"
          android:textColor="#191C1E"
          android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- DESTINO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UBICACIÓN DESTINO"
        android:textStyle="bold"
        android:textColor="#44474E"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:startIconDrawable="@drawable/ic_location_on">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etUbicacionDestino"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="Ej: Santiago de Chile"
          android:textColor="#191C1E"
          android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- TIPO CARGA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIPO DE CARGA"
        android:textStyle="bold"
        android:textColor="#44474E"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp">

      <AutoCompleteTextView
          android:id="@+id/etTipoCarga"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="Seleccionar"
          android:padding="14dp"
          android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- PRECIO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRECIO FLETE ($)"
        android:textStyle="bold"
        android:textColor="#44474E"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etPrecio"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="0.00"
          android:inputType="numberDecimal"
          android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- PESO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PESO FLETE (KG)"
        android:textStyle="bold"
        android:textColor="#44474E"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etPeso"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="Ej: 5000"
          android:inputType="number"
          android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- FECHA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FECHA DE REGISTRO"
        android:textStyle="bold"
        android:textColor="#44474E"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etFechaRegistro"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:focusable="false"
          android:hint="Seleccionar fecha"
          android:inputType="date"
          android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- BOTONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <Button
          android:id="@+id/btnCancelar"
          android:layout_width="0dp"
          android:layout_height="56dp"
          android:layout_weight="1"
          android:layout_marginEnd="8dp"
          android:backgroundTint="#FFFFFF"
          android:text="Cancelar"
          android:textAllCaps="false"
          android:textColor="#002046"
          android:textStyle="bold"/>

      <Button
          android:id="@+id/btnGuardar"
          android:layout_width="0dp"
          android:layout_height="56dp"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:backgroundTint="#FD8B00"
          android:text="Guardar Flete"
          android:textAllCaps="false"
          android:textColor="#FFFFFF"
          android:textStyle="bold"/>
    </LinearLayout>

  </LinearLayout>

</ScrollView>