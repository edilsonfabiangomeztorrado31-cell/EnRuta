<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.company.GestionFletesActivity">

  <androidx.cardview.widget.CardView
      android:id="@+id/cardLogin"
      android:layout_width="match_parent"
      android:layout_height="600dp"
      android:layout_marginStart="24dp"
      android:layout_marginEnd="24dp"
      app:cardCornerRadius="24dp"
      app:cardElevation="6dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:background="#FFFFFF">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="24dp"
          android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/layoutLugarOrigenUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            android:background="@android:color/white">
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutLugarDestinoUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            android:background="@android:color/white">
        </LinearLayout>

<!--        <LinearLayout-->
<!--            android:id="@+id/layoutBuscarDirreccion"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:orientation="vertical"-->
<!--            android:padding="0dp"-->
<!--            android:background="@android:color/white">-->
<!--        </LinearLayout>-->


        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Flete"
            android:textColor="@color/blue_logo"
            android:textSize="24sp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textStyle="bold"/>

        <TextView
            android:text="Ubicacion origen "
            android:textSize="16sp"
            android:textColor="#121516"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:hint="Ingrese el origen del flete"
            android:id="@+id/etUbicacionOrigen"
            android:background="#F1F2F4"
            android:padding="12dp"
            android:textColor="#121516"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:inputType="text"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:singleLine="true"/>

        <TextView
            android:text="Ubicacion destino "
            android:textSize="16sp"
            android:textColor="#121516"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:hint="Ingrese el destino del flete"
            android:id="@+id/etUbicacionDestino"
            android:background="#F1F2F4"
            android:padding="12dp"
            android:textColor="#121516"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:inputType="text"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:singleLine="true"/>
        <TextView
            android:text="Tipo de carga"
            android:textSize="16sp"
            android:textColor="#121516"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:hint="Ingrese el tipo de carga"
            android:id="@+id/etTipoCarga"
            android:background="#F1F2F4"
            android:padding="12dp"
            android:textColor="#121516"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:text="Precio flete"
            android:textSize="16sp"
            android:textColor="#121516"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:hint="Ingrese el precio del flete"
            android:id="@+id/etPrecio"
            android:background="#F1F2F4"
            android:padding="12dp"
            android:textColor="#121516"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:text="Peso flete"
            android:textSize="16sp"
            android:textColor="#121516"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:hint="Ingrese el peso en toneladas"
            android:id="@+id/etPeso"
            android:inputType="numberDecimal"
            android:background="#F1F2F4"
            android:padding="12dp"
            android:textColor="#121516"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:text="Fecha registro"
            android:textSize="16sp"
            android:textColor="#121516"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:hint="Ingrese fecha de registro"
            android:id="@+id/etFechaRegistro"
            android:inputType="numberDecimal"
            android:background="#F1F2F4"
            android:padding="12dp"
            android:textColor="#121516"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="10dp">

          <Button
              android:id="@+id/btnRegistrarFlete"
              android:layout_width="180dp"
              android:layout_height="wrap_content"
              android:background="@drawable/bg_button_azul"
              android:text="Registrar"
              android:textColor="@color/white"
              android:backgroundTint="@null"
              app:backgroundTint="@null"/>


        </LinearLayout>
      </LinearLayout>
    </ScrollView>
  </androidx.cardview.widget.CardView>

  </androidx.constraintlayout.widget.ConstraintLayout>