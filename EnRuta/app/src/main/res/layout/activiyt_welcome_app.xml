<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Imagen de fondo -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_app_welcome"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="160dp"
        android:layout_height="110dp"
        android:layout_marginStart="290dp"
        android:src="@drawable/logo_app"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvSeleccionRol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="200dp"
        android:text="Elige tu rol para comenzar."
        android:textColor="#0A1F44"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardEmpresa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="100dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white_btn"
        android:layout_below="@id/tvSeleccionRol"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnEmpresa"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@color/white_btn"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:text="Soy Empresa"
            android:textColor="@color/blue_logo"
            app:backgroundTint="@null" />

    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:id="@+id/cardTransportador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white_btn"
        android:layout_below="@id/cardEmpresa"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnTransportador"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@color/white_btn"
            android:drawableLeft="@drawable/ic_transportador"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:text="Soy Transportador"
            android:textColor="@color/blue_logo"
            app:backgroundTint="@null" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvNecesitasayuda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_below="@id/cardTransportador"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="85dp"
        android:text="¿Necesitas ayuda?"
        android:textColor="@color/white"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/tvContactanos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="35dp"
        android:layout_below="@id/tvNecesitasayuda"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:textColor="#0A1F44"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@string/contactanos"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:autoLink="none"/>
</RelativeLayout>
