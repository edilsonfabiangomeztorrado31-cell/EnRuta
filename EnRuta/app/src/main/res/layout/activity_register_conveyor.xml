<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/conveyor_background_login" />

    <!-- Card de login superpuesto parcialmente sobre la imagen -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        android:foregroundGravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:background="#FFFFFF">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Registro de Transportador"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#121516"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Nombre "
                android:textSize="16sp"
                android:textColor="#121516"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <EditText
                android:hint="Ingrese nombre"
                android:id="@+id/etNombreConveyor"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:text="Apellidos"
                android:textSize="16sp"
                android:textColor="#121516"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <EditText
                android:hint="Ingrese apellidos"
                android:id="@+id/etApellido"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:text="Tipo de documento"
                android:textSize="16sp"
                android:textColor="#121516"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
                <Spinner
                    android:id="@+id/spinnerTipoDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Tipo documento"
                    android:background="@android:color/transparent"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/white_hueso"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="0dp"
                    android:drawablePadding="8dp"
                    android:textSize="15sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Numero de documentacion"
                android:textColor="#121516"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:hint="Ingrese numero de documento"
                android:id="@+id/etNumDocumento"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gmail"
                android:textColor="#121516"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:hint="Ingrese correo electronico"
                android:id="@+id/etCorreo"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Contacto"
                android:textColor="#121516"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:hint="Ingrese numero de documento"
                android:id="@+id/etContacto"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Placa"
                android:textColor="#121516"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:hint="Ingrese numero de placa"
                android:id="@+id/etPlaca"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Peso"
                android:textColor="#121516"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:hint="Ingrese el peso en toneladas"
                android:id="@+id/etCapacidadToneladas"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tipo de vehículo"
                android:textColor="#121516"
                android:textSize="16sp"
                android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spinnerTipoVehiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Tipo vehículo"
                    android:background="@android:color/transparent"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/white_hueso"
                    android:paddingBottom="0dp"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="8dp"
                    android:textSize="15sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Contraseña"
                android:textColor="#121516"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:hint="Ingrese su contraseña"
                android:id="@+id/etPasssword"
                android:background="#F1F2F4"
                android:padding="12dp"
                android:textColor="#121516"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnRegistrarseConveyor"
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_azul"
                        android:text="Registrarse"
                        android:textColor="@color/white"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"/>

                </LinearLayout>

                <!-- Texto olvidaste contraseña -->
                <TextView
                    android:id="@+id/tvTienesCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="¿Ya tienes cuenta?"
                    android:textColor="@color/blue_logo"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/tvIniciaSesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/iniciaSeccion"
                    android:textColor="@color/blue_logo"
                    android:textSize="15sp"
                    android:layout_below="@id/tvTienesCuenta" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
