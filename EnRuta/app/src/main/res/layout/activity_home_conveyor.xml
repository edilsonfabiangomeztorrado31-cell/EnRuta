<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <!-- Card flotante -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardContent"
            android:layout_width="350dp"
            android:layout_height="570dp"
            android:layout_marginTop="100dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Icono ubicación y texto -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivUbicacion"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ubicacion" />

                    <TextView
                        android:id="@+id/tvActualizarUbicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actualizar ubicación aquí"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:paddingStart="8dp"/>
                </LinearLayout>

                <!-- Título -->
                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estos son los fletes disponibles cerca de ti. ¡Tómalos y ponte EnRuta!"
                    android:textColor="@color/black"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:textSize="16sp"/>

                <!-- Buscador -->
                <EditText
                    android:id="@+id/etBuscarCiudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar por ciudad"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:background="@drawable/bg_search_edittext"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                <!-- CardView con detalles del flete -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFleteDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvFleteDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Origen: Bogotá, Cundinamarca\nDestino: Cali, Valle del Cauca\nCarga: Electrodomésticos\nPeso: 7 Toneladas\nPago: $1.800.000\nFecha: 20/04/2025"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:layout_marginBottom="12dp" />

                        <Button
                            android:id="@+id/btnDetalleFlete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Detalle Flete"
                            android:backgroundTint="@color/naranja"
                            android:textColor="@android:color/white" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                    <!-- CardView con detalles del flete -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFleteDetalle2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        android:layout_margin="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvFleteDetalle2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Origen: Bogotá, Cundinamarca\nDestino: Cali, Valle del Cauca\nCarga: Electrodomésticos\nPeso: 7 Toneladas\nPago: $1.800.000\nFecha: 20/04/2025"
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:layout_marginBottom="12dp" />

                            <Button
                                android:id="@+id/btnDetalleFlete2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Detalle Flete"
                                android:backgroundTint="@color/naranja"
                                android:textColor="@android:color/white" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                        <!-- CardView con detalles del flete -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardFleteDetalle3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="6dp"
                            android:layout_margin="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/tvFleteDetalle3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Origen: Bogotá, Cundinamarca\nDestino: Cali, Valle del Cauca\nCarga: Electrodomésticos\nPeso: 7 Toneladas\nPago: $1.800.000\nFecha: 20/04/2025"
                                    android:textSize="14sp"
                                    android:textColor="@color/black"
                                    android:layout_marginBottom="12dp" />

                                <Button
                                    android:id="@+id/btnDetalleFlete3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Detalle Flete"
                                    android:backgroundTint="@color/naranja"
                                    android:textColor="@android:color/white" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TEXTO: ¿Necesitas ayuda? -->
        <TextView
            android:id="@+id/textHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Necesitas ayuda? "
            android:textColor="@color/blue_logo"
            app:layout_constraintBottom_toTopOf="@id/textContactanos"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="8dp" />

        <!-- TEXTO: Contáctanos -->
        <TextView
            android:id="@+id/textContactanos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contactanos"
            android:textColor="@color/blue_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="52dp"
            android:layout_marginBottom="24dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>


