<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:fillViewport="true">

            <!-- Este LinearLayout es EL único hijo del ScrollView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOrigen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Origen: Bogotá"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvDestino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Destino: Medellín"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvTipoCarga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo de carga: Refrigerada"
                    android:textSize="16sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Peso: 1500 kg"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvPrecio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Precio: $1.200.000"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha: 2025-05-20"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </ScrollView>

        <!-- El botón queda fuera del ScrollView -->
        <Button
            android:id="@+id/btnTomarFlete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tomar Flete"
            android:backgroundTint="@color/naranja"
            android:textSize="16sp"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>
