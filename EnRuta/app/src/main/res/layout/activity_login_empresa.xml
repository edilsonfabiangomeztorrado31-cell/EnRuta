<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5E7EB">

    <!-- Imagen de fondo -->
    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="370dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_empresa" />

    <!-- Logo EnRuta -->
    <ImageView
        android:id="@+id/logoEnRuta"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@drawable/logo_app"
        android:contentDescription="Logo" />

    <!-- Card de login superpuesto parcialmente sobre la imagen -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="-50dp"
        android:layout_below="@id/imgFondo"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFFFFF">

            <!-- Botones de pestaña -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <Button
                        android:id="@+id/btnIniciarSesion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Iniciar sesión"
                        android:backgroundTint="@null"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_button_azul"
                        app:backgroundTint="@null"
                        android:translationZ="8dp"
                        android:elevation="8dp"/>
                    <Button
                        android:id="@+id/btnRegistrarse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Registrarse"
                        android:backgroundTint="@null"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_button_naranja"
                        app:backgroundTint="@null"/>


                </LinearLayout>
            </FrameLayout>


            <!-- Título -->
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:text="¡Bienvenido al rol de empresa!"
                android:textColor="#0A1F44"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Input contacto -->
            <EditText
                android:id="@+id/etNI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Ingresa tu Ni"
                android:background="@android:color/transparent"
                android:inputType="phone"
                android:textColor="@color/white_hueso"
                android:paddingBottom="8dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp" />

            <!-- Línea separadora -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <!-- Input contraseña -->
            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Ingresa tu contraseña"
                android:background="@android:color/transparent"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:paddingBottom="8dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <!-- Botón iniciar sesión -->


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnLoginTransportador"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_azul"
                android:text="Iniciar sesión"
                android:textColor="@color/white"
                android:backgroundTint="@null"
                app:backgroundTint="@null"/>

        </LinearLayout>

            <!-- Texto olvidaste contraseña -->
            <TextView
                android:id="@+id/tvOlvidasteContraseña"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/blue_logo"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tvRecuperar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:text="@string/recuperala"
                android:textColor="@color/blue_logo"
                android:textSize="15sp"
                android:layout_below="@id/tvOlvidasteContraseña" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
